# --- FastAccounts ----------------------------------------------------------
FASTACCOUNTS_ADMIN_EMAIL=admin@fastaccounts.example
FASTACCOUNTS_ADMIN_PASSWORD=
FASTACCOUNTS_SECRET=
FASTACCOUNTS_PORT=5012
FASTACCOUNTS_ENV_LABEL=FastAccounts
# Optional initial language override; explicit session choices still win (en/et/lv/lt).
FASTACCOUNTS_DEFAULT_LANG=en
FASTACCOUNTS_RELOAD=false
FASTACCOUNTS_PUBLIC_URL=http://localhost:5012
FASTACCOUNTS_COMMIT=
FASTACCOUNTS_BRANCH=
FASTACCOUNTS_BUILD_DATE=
FASTACCOUNTS_DB=
FASTACCOUNTS_DATA_DIR=./data
MAX_ATTACHMENT_BYTES=10485760
FASTACCOUNTS_ENCRYPTION_KEY=
FASTACCOUNTS_ENCRYPTION_KEY_VERSION=1
FASTACCOUNTS_CORS_ORIGINS=
FASTACCOUNTS_ALLOW_TEST_AUTH=false

# PostgreSQL is the production accounting store. SQLite is for local demo use.
DB_URL=
DB_SCHEMA=fast_accounts
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=3
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_POOL_MAX_IDLE=300
DB_APPLICATION_NAME=fastaccounts

# Google SSO and shared FastSME local accounts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5012/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=
FASTSME_AUTH_DB=

# Transactional invoice and account email (Postmark server token and an approved
# sender, e.g. info@fastsme.com). Sign-up confirmation and password-reset links use
# FASTACCOUNTS_PUBLIC_URL; without these values the requests log a warning and
# show the generic message.
POSTMARK_API_TOKEN=
FROM_EMAIL=

# Scheduled recurring invoices and payment reminders. The worker is off by
# default; set to true on exactly one deployment instance.
FASTACCOUNTS_AUTOMATION_WORKER=false
FASTACCOUNTS_AUTOMATION_POLL_SECONDS=60
# Default reminder ladder: 3 days before due, then 7 and 14 days overdue; not configurable per environment.

# Public API writes and signed provider webhooks
FASTSME_API_TOKEN=
FASTACCOUNTS_WEBHOOK_SECRET=

# QuickBooks Online (planned)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:5012/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Xero (planned)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:5012/integrations/xero/callback

# Merit Aktiva (planned; company credentials should normally live encrypted in
# the database, not globally in .env; these are useful only for a local fixture)
MERIT_API_ID=
MERIT_API_KEY=
MERIT_API_BASE_URL=https://aktiva.merit.ee/api/v2

# HMRC Making Tax Digital for VAT (planned)
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_REDIRECT_URI=http://localhost:5012/integrations/hmrc/callback
HMRC_API_BASE_URL=https://test-api.service.hmrc.gov.uk

# Open-banking aggregator (provider decision is still open)
OPEN_BANKING_PROVIDER=
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
OPEN_BANKING_REDIRECT_URI=http://localhost:5012/integrations/banking/callback
