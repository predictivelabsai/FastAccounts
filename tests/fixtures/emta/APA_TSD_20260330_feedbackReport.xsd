<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
    <xs:element name="processing" type="processing">
        <xs:annotation>
            <xs:documentation>Tagasisideraport. Süsteemi poolt koostatav ja edastatav raport, millega süsteem teavitab, et TSD andmete töötlemine on lõppenud.
                Sõnum sisaldab endas andmete töötlemise tulemuse ning vigadega esinemise puhul ka kas XML struktuuri vead või andmete mittevastavusest tingitud vead.
                Uploaded data report. Message is generated by the system to notify that the uploaded data has been processed.
                Message contains within itself a result for each processed item and errors in case they are present. 
                Errors that are shown are either XML structure errors or errors related to non-compliant data.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:complexType name="entryHeader">
        <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="1" name="entryNumber" type="entryNumber"
                nillable="false">
                <xs:annotation>
                    <xs:documentation>Andmesektsiooni kood. Code of the entry header.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="1" maxOccurs="unbounded" name="validations" type="validations">
                <xs:annotation>
                    <xs:documentation>Konkreetse andmesektsiooni andmete töötlemise tulemused. Validation results for this group</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="responseData" type="responseData">
                <xs:annotation>
                    <xs:documentation>Väljamaksete kohta käiv täiendav informatsioon - maksuandmed ja veateated

Additional information about entryDetail - tax calculations, warnings and errors.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="validations">
        <xs:sequence>
            <xs:element name="validation" type="validation" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation/>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="validation">
        <xs:sequence>
            <xs:element name="errorLevel" type="errorLevel"/>
            <xs:element name="errorCode" type="errorCode"/>
            <xs:element name="errorDescription" type="errorDescription">
                <xs:annotation>
                    <xs:documentation>Vea kirjeldus. Error description.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="errorDescription_EN" type="errorDescription_EN"/>
            <xs:element minOccurs="0" name="errorDescription_RU" type="errorDescription_RU"/>
            <xs:element maxOccurs="unbounded" name="lineReferences" type="lineReferences"
                minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Viited konkreetsetele andmekirjetele, mille kohta vastav viga kehtib. Reference to data item that is related to this validation result.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="processing">
        <xs:sequence>
            <xs:element minOccurs="1" maxOccurs="unbounded" name="entryHeader" type="entryHeader">
                <xs:annotation>
                    <xs:documentation>Andmed on grupeeritud andmesektsiooni kaupa. Vead, mis ei käi konkreetse andmesektsiooni kohta, on grupeeritud eraldi. 
Data is grouped by entry header codes. Errors that are not related to a certain entry header code are grouped together to a separate group. </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute ref="result"/>
    </xs:complexType>
    <xs:complexType name="responseData">
        <xs:annotation>
            <xs:documentation/>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="entryDetail" type="entryDetail" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Konkreetse väljamakse kohta käiv informatsioon

Information about one entryDetail</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="lineReferences">
        <xs:sequence>
            <xs:element maxOccurs="unbounded" name="lineReference" type="lineReference"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="lineReference">
        <xs:sequence>
            <xs:element name="lineInternalId" type="lineInternalId"/>
            <xs:element name="lineNumberCounter" type="lineNumberCounter"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="data">
        <xs:sequence>
            <xs:element name="code" type="code">
                <xs:annotation>
                    <xs:documentation>Maksu liigi kood või veateate kood

Tax code or error code</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="description" type="description"/>
            <xs:element name="info" type="info">
                <xs:annotation>
                    <xs:documentation>Maksu summa või veateade eesti keeles

Tax sum or error message in Estonian</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="info_EN" type="info_EN"/>
            <xs:element minOccurs="0" name="info_RU" type="info_RU"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="entryDetail">
        <xs:sequence>
            <xs:element name="lineReferences" type="lineReferences" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Viide andmekirjele, mille maksude ja veateadete info data elementidena toodud on.

Reference data to the entryDetail</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="unbounded" name="data" type="data">
                <xs:annotation>
                    <xs:documentation>Konkreetse maksu või veateate andmestik

Data about one tax calculation, warning or error.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:simpleType name="errorDescription">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:simpleType name="entryNumber">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:simpleType name="lineNumberCounter">
        <xs:restriction base="xs:integer"/>
    </xs:simpleType>
    <xs:simpleType name="errorLevel">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:simpleType name="errorCode">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:simpleType name="errorDescription_EN">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:simpleType name="errorDescription_RU">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:simpleType name="lineInternalId">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:attribute name="result" type="xs:string"/>
    <xs:simpleType name="code">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:simpleType name="description">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:simpleType name="info">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:simpleType name="info_EN">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
    <xs:simpleType name="info_RU">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
</xs:schema>
